<resources>
    <style name="Theme.EquipX" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/equipx_white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch theme: Android 12+ SplashScreen API (backported by core-splashscreen); swaps to Theme.EquipX after launch. -->
    <style name="Theme.EquipX.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.EquipX</item>
    </style>
</resources>
