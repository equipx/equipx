{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equipx.app/schema/missions.schema.json",
  "title": "EquipX missions",
  "type": "object",
  "additionalProperties": false,
  "required": ["missions"],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1 },
    "scanTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "deviceId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "scan" },
        "title": { "$ref": "#/$defs/text" },
        "deviceId": { "$ref": "#/$defs/id" }
      }
    },
    "identifyPartTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "deviceId", "partId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "identify_part" },
        "title": { "$ref": "#/$defs/text" },
        "deviceId": { "$ref": "#/$defs/id" },
        "partId": { "$ref": "#/$defs/id" }
      }
    },
    "completeProcedureTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "deviceId", "procedureId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "complete_procedure" },
        "title": { "$ref": "#/$defs/text" },
        "deviceId": { "$ref": "#/$defs/id" },
        "procedureId": { "$ref": "#/$defs/id" }
      }
    },
    "passQuizTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "deviceId", "quizId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "pass_quiz" },
        "title": { "$ref": "#/$defs/text" },
        "deviceId": { "$ref": "#/$defs/id" },
        "quizId": { "$ref": "#/$defs/id" },
        "minScorePct": { "type": "integer", "minimum": 1, "maximum": 100, "default": 70 }
      }
    },
    "task": {
      "oneOf": [
        { "$ref": "#/$defs/scanTask" },
        { "$ref": "#/$defs/identifyPartTask" },
        { "$ref": "#/$defs/completeProcedureTask" },
        { "$ref": "#/$defs/passQuizTask" }
      ]
    }
  },
  "properties": {
    "missions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "tasks"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "$ref": "#/$defs/text" },
          "description": { "$ref": "#/$defs/text" },
          "deviceId": { "$ref": "#/$defs/id" },
          "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
        }
      }
    }
  }
}
